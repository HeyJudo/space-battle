# Native build output (desktop and test builds)
build/
bin/
out/
*.o
*.obj
*.exe
*.pdb
*.ilk
*.exp
*.dSYM/

# The web build in web/ IS committed on purpose: the client runs it
# with Live Server without installing Emscripten (see SPEC.md).

# Toolchains installed inside the project
emsdk/
.emscripten_cache/

# Editor: keep shared VS Code config, ignore personal settings
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/c_cpp_properties.json
!.vscode/extensions.json
.vs/
*.code-workspace

# OS and OneDrive clutter
Thumbs.db
desktop.ini
.DS_Store
*.tmp
~$*

# Logs
*.log
